exports[`workspace tool surface > workspace_read_items input schema is stable 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "requests": {
      "description": "Ordered workspace content reads, at most 20.",
      "items": {
        "anyOf": [
          {
