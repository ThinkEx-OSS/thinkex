                    "type": "string",
                  },
                },
                "required": [
                  "op",
                  "cardId",
                ],
                "type": "object",
              },
            ],
          },
          "maxItems": 100,
          "minItems": 1,
          "type": "array",
        },
        "path": {
          "description": "Absolute path of one actual ThinkEx flashcard set to edit.",
          "minLength": 1,
          "type": "string",
        },
        "type": {
