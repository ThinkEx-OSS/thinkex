{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Default config is used for local development. Deploys should target an
	// explicit Wrangler environment. This name deliberately differs from the
	// production worker name so a bare `wrangler deploy` cannot overwrite
	// production with this block's staging R2 and Vectorize bindings.
	"name": "thinkex-dev",
	"compatibility_date": "2026-03-24",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/server.ts",
	"version_metadata": {
		"binding": "CF_VERSION_METADATA",
	},
	"workers_dev": true,
	"preview_urls": true,
	// Off deliberately, and inherited by every environment. Two reasons, both
	// load-bearing:
	//
	//  1. Every HTML response we return carries a Set-Cookie (the consent-region
	//     cookie in src/server.ts), which is an automatic cache bypass. Turning
	//     caching on would not cache a single page — it would only add a cache
	//     tier lookup ahead of every request. Cloudflare names this exact
	//     anti-pattern in workers/cache/configuration.
	//  2. The cache key does not include Cookie. Any HTML that did get stored
	//     would be served across users, and `/` in particular would stop
	//     redirecting signed-in visitors to /home.
	//
	// Static assets are served by the assets layer, which bypasses the Worker, so
	// there is nothing left for this to win on them either. Note that "cached" and
	// "cached in the browser" are separate questions: the assets layer caches at
	// the edge, but the browser cache is governed by the Cache-Control it sends,
	// which defaults to `max-age=0, must-revalidate`. public/_headers overrides
	// that for the content-hashed files under /assets/ — read it before assuming
	// an asset is free on a repeat visit. Before ever flipping this flag:
	// responses with no Cache-Control are not exempt — a 200 falls back to RFC
	// 9111 heuristic freshness and is cached for 2 hours.
	"cache": {
		"enabled": false,
	},
	// Do not send our npm dependency list to Cloudflare on every deploy.
	// See wrangler 4.110 release notes (added the opt-in default).
	"dependencies_instrumentation": {
		"enabled": false,
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true,
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
		},
	},
	"ai": {
		"binding": "AI",
		"remote": true,
	},
	// Provisioning: docs/configuration/deployments.mdx#workspace-search-vector-indexes
	"vectorize": [
		{
			"binding": "WORKSPACE_SEARCH",
			"index_name": "thinkex-workspace-search-staging",
			"remote": true,
		},
	],
	"images": {
		"binding": "IMAGES",
	},
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	"browser": {
		"binding": "BROWSER",
		"remote": true,
	},
	"vars": {
		"FIRECRAWL_API_URL": "https://api.firecrawl.dev",
		"R2_BUCKET_NAME": "thinkex-workspace-kernel-files-staging",
		"SANDBOX_TRANSPORT": "rpc",
	},
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true,
		},
	],
	"r2_buckets": [
		{
			"binding": "WORKSPACE_KERNEL_FILES",
			"bucket_name": "thinkex-workspace-kernel-files-staging",
			"remote": true,
		},
	],
	"secrets": {
		"required": [
			"BETTER_AUTH_URL",
			"BETTER_AUTH_SECRET",
			"GOOGLE_CLIENT_ID",
			"GOOGLE_CLIENT_SECRET",
			"FIRECRAWL_API_KEY",
			"LLAMA_CLOUD_API_KEY",
			"AI_GATEWAY_API_KEY",
			"AUTUMN_SECRET_KEY",
			"TCC_API_KEY",
			"R2_ACCOUNT_ID",
			"R2_ACCESS_KEY_ID",
			"R2_SECRET_ACCESS_KEY",
			"WORKSPACE_UPLOAD_TOKEN_SECRET",
		],
	},
	"workflows": [
		{
			"name": "workspace-file-extraction",
			"binding": "WORKSPACE_FILE_EXTRACTION_WORKFLOW",
			"class_name": "WorkspaceFileExtractionWorkflow",
		},
	],
	"containers": [
		{
			"class_name": "Sandbox",
			"image": "./containers/sandbox/Dockerfile",
			"instance_type": "basic",
		},
		{
			"class_name": "OfficePdfConverter",
			"image": "./containers/gotenberg/Dockerfile",
			"instance_type": "standard-1",
			"max_instances": 1,
		},
		{
			"class_name": "WorkspaceFileProcessor",
			"image": "./containers/liteparse/Dockerfile",
			"instance_type": "standard-2",
			"max_instances": 2,
		},
	],
	"upload_source_maps": true,
	"durable_objects": {
		"bindings": [
			{
				"name": "UserAIStore",
				"class_name": "UserAIStore",
			},
			{
				"name": "WorkspaceKernel",
				"class_name": "WorkspaceKernel",
			},
			{
				"name": "DocumentSession",
				"class_name": "DocumentSession",
			},
			{
				"name": "CODE_SANDBOX",
				"class_name": "Sandbox",
			},
			{
				"name": "OFFICE_PDF_CONVERTER",
				"class_name": "OfficePdfConverter",
			},
			{
				"name": "WORKSPACE_FILE_PROCESSOR",
				"class_name": "WorkspaceFileProcessor",
			},
		],
	},
	"migrations": [
		{
			"tag": "v2_user_ai_store",
			"new_sqlite_classes": ["UserAIStore"],
		},
		{
			"tag": "v3_workspace_kernel",
			"new_sqlite_classes": ["WorkspaceKernel"],
		},
		{
			"tag": "v4_document_session",
			"new_sqlite_classes": ["DocumentSession"],
		},
		{
			"tag": "v5_office_pdf_converter",
			"new_sqlite_classes": ["OfficePdfConverter"],
		},
		{
			"tag": "v6_code_sandbox",
			"new_sqlite_classes": ["Sandbox"],
		},
		{
			"tag": "v7_image_file_converter",
			"new_sqlite_classes": ["ImageFileConverter"],
		},
		{
			"tag": "v8_liteparse_pdf_extractor",
			"new_sqlite_classes": ["LiteParsePdfExtractor"],
		},
		{
			"tag": "v9_workspace_file_processor",
			"renamed_classes": [
				{
					"from": "LiteParsePdfExtractor",
					"to": "WorkspaceFileProcessor",
				},
			],
		},
		{
			"tag": "v10_remove_image_file_converter",
			"deleted_classes": ["ImageFileConverter"],
		},
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "thinkex",
			"database_id": "e5ff462d-fab3-4ab2-9259-fd107c2df809",
			"migrations_dir": "drizzle",
		},
	],
	"env": {
		"staging": {
			"name": "thinkex-staging",
			"version_metadata": {
				"binding": "CF_VERSION_METADATA",
			},
			"routes": [
				{
					"pattern": "staging.thinkex.app",
					"custom_domain": true,
				},
			],
			// Provision dedicated staging resources before the first deploy.
			"vars": {
				"FIRECRAWL_API_URL": "https://api.firecrawl.dev",
				"R2_BUCKET_NAME": "thinkex-workspace-kernel-files-staging",
				"SANDBOX_TRANSPORT": "rpc",
			},
			"secrets": {
				"required": [
					"BETTER_AUTH_URL",
					"BETTER_AUTH_SECRET",
					"GOOGLE_CLIENT_ID",
					"GOOGLE_CLIENT_SECRET",
					"FIRECRAWL_API_KEY",
					"LLAMA_CLOUD_API_KEY",
					"AI_GATEWAY_API_KEY",
					"AUTUMN_SECRET_KEY",
					"TCC_API_KEY",
					"R2_ACCOUNT_ID",
					"R2_ACCESS_KEY_ID",
					"R2_SECRET_ACCESS_KEY",
					"WORKSPACE_UPLOAD_TOKEN_SECRET",
				],
			},
			"ai": {
				"binding": "AI",
				"remote": true,
			},
			"vectorize": [
				{
					"binding": "WORKSPACE_SEARCH",
					"index_name": "thinkex-workspace-search-staging",
					"remote": true,
				},
			],
			"images": {
				"binding": "IMAGES",
			},
			"worker_loaders": [
				{
					"binding": "LOADER",
				},
			],
			"browser": {
				"binding": "BROWSER",
				"remote": true,
			},
			"send_email": [
				{
					"name": "EMAIL",
					"remote": true,
				},
			],
			"r2_buckets": [
				{
					"binding": "WORKSPACE_KERNEL_FILES",
					"bucket_name": "thinkex-workspace-kernel-files-staging",
				},
			],
			"workflows": [
				{
					"name": "workspace-file-extraction-staging",
					"binding": "WORKSPACE_FILE_EXTRACTION_WORKFLOW",
					"class_name": "WorkspaceFileExtractionWorkflow",
				},
			],
			"containers": [
				{
					"class_name": "Sandbox",
					"image": "registry.cloudflare.com/676650ed1ca37ffdeba997fb2a7fa24a/thinkex-sandbox-production@sha256:e4362dd1268e85c681c9a4646785a473761ca6af8749bfff0236bf86a4809b6b",
					"instance_type": "basic",
				},
				{
					"class_name": "OfficePdfConverter",
					"image": "registry.cloudflare.com/676650ed1ca37ffdeba997fb2a7fa24a/thinkex-officepdfconverter-production@sha256:a715bacdff834aa8a5cda7741e0baa21ab0cb9dde54155155b5ee722ecc162f0",
					"instance_type": "standard-1",
					"max_instances": 2,
				},
				{
					"class_name": "WorkspaceFileProcessor",
					"image": "registry.cloudflare.com/676650ed1ca37ffdeba997fb2a7fa24a/thinkex-liteparsepdfextractor-production@sha256:6f5ce1241aa607fd4b12588656aa587974352fe4a0eff3f0e526dbf78a78da49",
					"instance_type": "standard-2",
					"max_instances": 2,
				},
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "UserAIStore",
						"class_name": "UserAIStore",
					},
					{
						"name": "WorkspaceKernel",
						"class_name": "WorkspaceKernel",
					},
					{
						"name": "DocumentSession",
						"class_name": "DocumentSession",
					},
					{
						"name": "CODE_SANDBOX",
						"class_name": "Sandbox",
					},
					{
						"name": "OFFICE_PDF_CONVERTER",
						"class_name": "OfficePdfConverter",
					},
					{
						"name": "WORKSPACE_FILE_PROCESSOR",
						"class_name": "WorkspaceFileProcessor",
					},
				],
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "thinkex-staging",
					"database_id": "babf13a7-a12d-4946-83da-29370106d728",
					"migrations_dir": "drizzle",
				},
			],
		},
		"production": {
			"name": "thinkex",
			"version_metadata": {
				"binding": "CF_VERSION_METADATA",
			},
			"routes": [
				{
					"pattern": "thinkex.app",
					"custom_domain": true,
				},
			],
			"vars": {
				"FIRECRAWL_API_URL": "https://api.firecrawl.dev",
				"R2_BUCKET_NAME": "thinkex-workspace-kernel-files",
				"SANDBOX_TRANSPORT": "rpc",
			},
			"secrets": {
				"required": [
					"BETTER_AUTH_URL",
					"BETTER_AUTH_SECRET",
					"GOOGLE_CLIENT_ID",
					"GOOGLE_CLIENT_SECRET",
					"FIRECRAWL_API_KEY",
					"LLAMA_CLOUD_API_KEY",
					"AI_GATEWAY_API_KEY",
					"AUTUMN_PROD_SECRET_KEY",
					"TCC_API_KEY",
					"R2_ACCOUNT_ID",
					"R2_ACCESS_KEY_ID",
					"R2_SECRET_ACCESS_KEY",
					"WORKSPACE_UPLOAD_TOKEN_SECRET",
				],
			},
			"ai": {
				"binding": "AI",
				"remote": true,
			},
			"vectorize": [
				{
					"binding": "WORKSPACE_SEARCH",
					"index_name": "thinkex-workspace-search",
					"remote": true,
				},
			],
			"images": {
				"binding": "IMAGES",
			},
			"worker_loaders": [
				{
					"binding": "LOADER",
				},
			],
			"browser": {
				"binding": "BROWSER",
				"remote": true,
			},
			"send_email": [
				{
					"name": "EMAIL",
					"remote": true,
				},
			],
			"r2_buckets": [
				{
					"binding": "WORKSPACE_KERNEL_FILES",
					"bucket_name": "thinkex-workspace-kernel-files",
				},
			],
			"workflows": [
				{
					"name": "workspace-file-extraction",
					"binding": "WORKSPACE_FILE_EXTRACTION_WORKFLOW",
					"class_name": "WorkspaceFileExtractionWorkflow",
				},
			],
			"containers": [
				{
					"class_name": "Sandbox",
					"image": "registry.cloudflare.com/676650ed1ca37ffdeba997fb2a7fa24a/thinkex-sandbox-production@sha256:e4362dd1268e85c681c9a4646785a473761ca6af8749bfff0236bf86a4809b6b",
					"instance_type": "basic",
				},
				{
					"class_name": "OfficePdfConverter",
					"image": "registry.cloudflare.com/676650ed1ca37ffdeba997fb2a7fa24a/thinkex-officepdfconverter-production@sha256:a715bacdff834aa8a5cda7741e0baa21ab0cb9dde54155155b5ee722ecc162f0",
					"instance_type": "standard-1",
					"max_instances": 2,
				},
				{
					"class_name": "WorkspaceFileProcessor",
					"image": "registry.cloudflare.com/676650ed1ca37ffdeba997fb2a7fa24a/thinkex-liteparsepdfextractor-production@sha256:6f5ce1241aa607fd4b12588656aa587974352fe4a0eff3f0e526dbf78a78da49",
					"instance_type": "standard-2",
					"max_instances": 2,
					"name": "thinkex-liteparsepdfextractor-production",
				},
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "UserAIStore",
						"class_name": "UserAIStore",
					},
					{
						"name": "WorkspaceKernel",
						"class_name": "WorkspaceKernel",
					},
					{
						"name": "DocumentSession",
						"class_name": "DocumentSession",
					},
					{
						"name": "CODE_SANDBOX",
						"class_name": "Sandbox",
					},
					{
						"name": "OFFICE_PDF_CONVERTER",
						"class_name": "OfficePdfConverter",
					},
					{
						"name": "WORKSPACE_FILE_PROCESSOR",
						"class_name": "WorkspaceFileProcessor",
					},
				],
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "thinkex",
					"database_id": "e5ff462d-fab3-4ab2-9259-fd107c2df809",
					"migrations_dir": "drizzle",
				},
			],
		},
	},
}
